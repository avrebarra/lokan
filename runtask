#!/usr/bin/env ruby
# frozen_string_literal: true

require "tmpdir"

# ─── commands (self-documenting) ─────────────────────────────────────────────
# %w[ns sub] => c("desc") { body } — run via ./runtask ns sub
# Block bodies resolve constants/methods at call time — helpers live below.

def c(desc, &block)
  [desc, block]
end

GROUPS = {
  ""    => "General",
  "dev" => "Dev",
  "web" => "Web (Vite React)",
}.freeze

COMMANDS = {
  %w[build]     => c("Build the full lokan binary (web + engine)") { cmd_build },
  %w[test]      => c("Run engine Go tests") { run "cd #{SCRIPT_DIR}/engine && go test ./..." },
  %w[e2e]       => c("End-to-end smoke: init, create, list, ui, API") { cmd_e2e },
  %w[bump]       => c("Bump patch version → git tag → push (release routine)")        { bump("patch") },
  %w[bump patch] => c("Bump patch version → git tag → push (release routine)")        { bump("patch") },
  %w[bump minor] => c("Bump minor version → git tag → push (release routine)")        { bump("minor") },
  %w[bump major] => c("Bump major version → git tag → push (release routine)")        { bump("major") },
  %w[bump dry]   => c("Preview the next version tag without tagging")                 { bump(nil, dry: true) },
  %w[dev web]    => c("Start Vite dev server + mock API (interactive UI)") { cmd_dev_web },
  %w[dev engine] => c("Run the built binary on a scratch board with demo data (no rebuild)") { cmd_dev_engine },
  %w[web mock]  => c("Run the mock API server only (port 8787)") { cmd_web_mock },
  %w[web build] => c("Build the web frontend only") { run "cd #{SCRIPT_DIR}/web && npm run build" },
}.freeze

# ─── config & helpers ────────────────────────────────────────────────────────

SCRIPT_DIR = File.dirname(File.expand_path(__FILE__))

def bail(msg)
  warn "error: #{msg}"
  exit 1
end

def run(cmd)
  puts "  $ #{cmd}"
  bail("#{cmd.split.first} failed") unless system(cmd)
  true
end

# build the vite app, copy dist into the engine embed dir, compile the binary
def cmd_build
  run "cd #{SCRIPT_DIR}/web && npm run build"
  run "rm -rf #{SCRIPT_DIR}/engine/web/dist"
  run "cp -r #{SCRIPT_DIR}/web/dist #{SCRIPT_DIR}/engine/web/dist"
  run "mkdir -p #{SCRIPT_DIR}/dist"
  run "cd #{SCRIPT_DIR}/engine && go build -o #{SCRIPT_DIR}/dist/lokan ./cmd/lokan"
  puts "built #{SCRIPT_DIR}/dist/lokan"
  true
end

# run the real binary against a scratch project seeded with demo data.
# Requires a built binary (dist/lokan) — run ./runtask build first; no rebuild
# here. Project lives in the OS tmpdir and is reused across runs (existing
# board is kept; only seeded when empty). Port via LOKAN_ENGINE_PORT.
def cmd_dev_engine
  bin = "#{SCRIPT_DIR}/dist/lokan"
  bail("dist/lokan not found — run ./runtask build first") unless File.exist?(bin)
  project = File.join(Dir.tmpdir, "lokan-engine")
  port = ENV["LOKAN_ENGINE_PORT"] || "7777"
  Dir.mkdir(project) unless Dir.exist?(project)

  Dir.chdir(project) do
    run "#{bin} init docs/board.md"
    pid = Process.spawn(bin, "ui", "--port", port, "docs/board.md", out: $stdout, err: $stderr)
    begin
      sleep 1.5
      board = File.read("docs/board.md") rescue ""
      if !board.include?("<!-- lokan:1 -->")
        puts "  seeding demo data…"
        system "curl -s -X POST http://localhost:#{port}/api/seed"
        puts ""
      end
      puts "lokan dev engine — http://localhost:#{port} (project: #{project})"
      puts "Press Ctrl+C to stop."
      Process.wait(pid)
    ensure
      begin
        Process.kill("INT", pid)
      rescue StandardError
        nil
      end
      begin
        Process.wait(pid)
      rescue StandardError
        nil
      end
    end
  end
  true
end

# run the mock API server (in-memory, implements docs/api.md) on port 8787
def cmd_web_mock
  run "cd #{SCRIPT_DIR}/web && node mock-server.mjs"
  true
end

# start the mock API server + Vite dev server together; kill mock on exit
def cmd_dev_web
  mock = Process.spawn("node mock-server.mjs", chdir: "#{SCRIPT_DIR}/web", out: $stdout, err: $stderr)
  begin
    run "cd #{SCRIPT_DIR}/web && npm run dev"
  ensure
    Process.kill("INT", mock) rescue nil
    Process.wait(mock) rescue nil
  end
  true
end

# end-to-end smoke against a scratch project in the OS tmp dir
def cmd_e2e
  run "cd #{SCRIPT_DIR} && ./runtask build"
  tmp = Dir.mktmpdir("lokan-e2e")
  bin = "#{SCRIPT_DIR}/dist/lokan"
  project = File.join(tmp, "proj")
  Dir.mkdir(project)

  Dir.chdir(project) do
    run "#{bin} init docs/board.md"
    run "#{bin} create docs/board.md --type task --priority high \"E2E task one\""
    run "#{bin} create docs/board.md --type task --priority low \"E2E task two\""
    run "#{bin} list docs/board.md"

    port = 7999
    pid = Process.spawn(bin, "ui", "--port", port.to_s, "docs/board.md", out: "/dev/null", err: "/dev/null")
    begin
      sleep 1.5
      body = `curl -s http://localhost:#{port}/api/tasks`
      bail("api/tasks returned no tasks") unless body.include?("E2E task one")
      html = `curl -s http://localhost:#{port}/`
      bail("ui did not serve index") unless html.include?("lokan")
      puts "e2e ok — ui + api live on port #{port}"
    ensure
      begin
        Process.kill("INT", pid)
      rescue StandardError
        nil
      end
      begin
        Process.wait(pid)
      rescue StandardError
        nil
      end
    end
  end
  FileUtils.remove_entry(tmp) rescue nil
  true
end

# bump the next release tag from the latest git tag (vX.Y.Z), then tag + push.
# The tag is the version — see docs/release.md. Bare `bump` bumps patch.
def bump(level, dry: false)
  level ||= "patch"

  # read the highest existing version tag, falling back to v0.0.0 before the
  # first release (version-sorted — describe mispicks with multi-tag commits)
  tag = `git tag -l "v*" --sort=-version:refname | head -1`.strip
  tag = "v0.0.0" if tag.empty?
  major, minor, patch = tag.delete_prefix("v").split(".").map(&:to_i)

  # compute the next version for the requested level
  case level
  when "major" then major += 1; minor = 0; patch = 0
  when "minor" then minor += 1; patch = 0
  else patch += 1
  end
  next_tag = "v#{major}.#{minor}.#{patch}"

  if dry
    puts "current tag: #{tag}"
    puts "next tag:    #{next_tag} (#{level})"
    return true
  end

  # a release ships the current tree — refuse to tag over uncommitted work
  unless `git status --porcelain`.strip.empty?
    bail "working tree is dirty — commit before bumping"
  end

  puts "bumping: #{tag} → #{next_tag} (#{level})"
  run "git tag #{next_tag}"
  run "git push origin #{next_tag}"
  puts "released #{next_tag} — GitHub Actions builds it (see docs/release.md)"
  true
end

# ─── usage (auto-generated) ──────────────────────────────────────────────────

def usage(group = nil)
  lines = ["Usage: ./runtask <command>", ""]
  groups = group ? { group => GROUPS[group] } : GROUPS
  groups.each do |ns, label|
    cmds = if ns == ""
      COMMANDS.select { |k, _| k.length == 1 }
    else
      COMMANDS.select { |k, _| k.length > 1 && k.first == ns }
    end
    next if cmds.empty?

    lines << "#{label}:"
    cmds.each do |k, (desc, _)|
      next if desc.nil?
      lines << "  #{k.join(' ').ljust(14)}#{desc}"
    end
    lines << ""
  end
  lines.join("\n")
end

# ─── dispatch ────────────────────────────────────────────────────────────────

input = ARGV.map(&:downcase)
entry = COMMANDS[input]

if entry
  exit entry[1].call ? 0 : 1
elsif input.length == 1 && GROUPS.key?(input[0])
  puts usage(input[0])
  exit 0
else
  puts usage
  exit 1
end
